{
  "name": "ocbc-simulator",
  "version": "1.0.0",
  "description": "<div align=\"center\">",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend-web",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend-web",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run backend\" \"npm run frontend\"",
    "setup": "npm run install:all && npm run dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
